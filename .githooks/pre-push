#!/bin/bash
# Space Lab guard: no force-pushes to main, and the same secret scan over everything being pushed.
z=0000000000000000000000000000000000000000
while read -r lref lsha rref rsha; do
  [ "$lsha" = "$z" ] && { [ "$rref" = "refs/heads/main" ] && { echo "BLOCKED: deleting main is not allowed."; exit 1; }; continue; }
  if [ "$rref" = "refs/heads/main" ] && [ "$rsha" != "$z" ] && ! git merge-base --is-ancestor "$rsha" "$lsha" 2>/dev/null; then
    echo "BLOCKED: this would rewrite the history of main (force push). Pull, merge and push normally."; exit 1
  fi
  range="$lsha"; [ "$rsha" != "$z" ] && range="$rsha..$lsha"
  files="$(git diff --name-only ${rsha/$z/$(git hash-object -t tree /dev/null)} "$lsha" 2>/dev/null)"
  if printf '%s\n' "$files" | grep -qE '^(data|logs|inbox)/|(^|/)settings\.json$|\.db$'; then
    echo "BLOCKED: private files are in the commits you are pushing:"; printf '%s\n' "$files" | grep -E '^(data|logs|inbox)/|settings\.json$|\.db$' | head | sed 's/^/  /'; exit 1
  fi
  if git log -p "$range" -- . ':(exclude).githooks' ':(exclude)AGENTS.md' 2>/dev/null | grep -E '^\+' | grep -qE 'discord(app)?\.com/api/webhooks/[0-9]+/|(ghp_|github_pat_)[A-Za-z0-9_]{20,}|/Users/[A-Za-z0-9._-]+/|@(gmail|icloud|yahoo|outlook|hotmail)\.com'; then
    echo "BLOCKED: a secret, personal email or Mac path is in the commits you are pushing."; exit 1
  fi
done
exit 0
